# CivicPulse AI - Environment Configuration
# Nebius Token Factory API Configuration
# Get your API key from https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here

# Nebius Token Factory Base URL
# Default us-central1 endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# NVIDIA Nemotron Model Identifier
# Verified models on Nebius Token Factory:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct
# - nvidia/nemotron-3-super-120b-a12b
# - nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct

# Database Path (Local SQLite)
DATABASE_PATH=civicpulse.db

# Application Environment (development, testing, production)
APP_ENV=development
